# Copy this file to .env.local and fill in AT LEAST ONE LLM key.
# The app tries providers in this order and falls back to the next one if a call fails.
LLM_PROVIDERS=qwen,gemini,deepseek,groq,openrouter,custom

# --- Bitget hackathon Qwen credits (apply via the Qwen form + Bitget KYC)
BITGET_QWEN_API_KEY=
# QWEN_MODEL=qwen3.8-max

# --- Google Gemini, free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- DeepSeek official API (very cheap): https://platform.deepseek.com
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# --- Groq, free tier: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# --- OpenRouter (has free models): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1:free

# --- Any other OpenAI-compatible endpoint (e.g. AgentRouter while developing)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# --- Bitget data (no keys needed)
# BITGET_API_BASE=https://api.bitget.com
# BITGET_MCP_URL=https://agent.bitget.com/mcp
# MCP_DIRECT_MAX=20        # above this many MCP tools, use catalog mode to save tokens
# TOOL_RESULT_CHARS=3500   # truncate long tool outputs
# AGENT_MAX_STEPS=7
